{
  "name": "voxaudax",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "admin:bootstrap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --conditions=react-server --import ./test/register-alias.mjs --env-file=.env scripts/bootstrap-admin.mts",
    "build": "next build",
    "check:connections": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/check-connections.mts",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:env": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-env-example.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/migrate.mts",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/seed.mts",
    "dev": "next dev --port 7896",
    "lint": "eslint",
    "mail:preview": "tsx --tsconfig tsconfig.scripts.json scripts/render-mail.mts",
    "rustfs:key": "node scripts/rustfs-access-key.mts",
    "shots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file=.env scripts/shots.ts",
    "start": "next start --port 7896",
    "test": "pnpm test:integration && pnpm test:unit",
    "test:integration": "node --test --experimental-strip-types --conditions=react-server --import ./test/register-alias.mjs --env-file=.env \"test/**/*.test.mts\"",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --env-file-if-exists=.env --test tests/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1137.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@velve/auth": "1.1.0",
    "drizzle-orm": "^0.45.3",
    "next": "15.5.25",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.7.1"
}
