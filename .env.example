DATABASE_URL=

S3_ENDPOINT=https://cdn.levo-studio.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=voxaudax
S3_REGION=eu-central-1
S3_FORCE_PATH_STYLE=true

RESEND_API_KEY=
MAIL_FROM=
MAIL_TO_EDITORIAL=redaktion@voxaudax.de

# The proxies in front of the application, as CIDR ranges or addresses,
# separated by commas. Empty means there is none and no X-Forwarded-For is
# believed. Behind Traefik in Docker this is usually the bridge network,
# e.g. 172.16.0.0/12 — check what `docker network inspect` says for yours.
TRUSTED_PROXIES=

AUTH_SECRET=
HEALTH_TOKEN=

NEXT_PUBLIC_SITE_URL=https://voxaudax.de
TZ=Europe/Berlin
