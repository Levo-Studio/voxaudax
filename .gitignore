# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: the example is committed, real values never are
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design source of record, kept locally rather than published
/.design/

# macOS copies a file it cannot overwrite to "<name> 2"; three of those had been
# committed and did nothing, while looking exactly like the file that does
* [0-9]

# playwright output: the screenshots stay local, the Lighthouse table is committed
/shots/*
!/shots/lighthouse.md
/test-results/
